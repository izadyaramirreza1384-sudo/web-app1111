{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app1111",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "eea98df6-2385-42e7-a52d-310ae983ab7d","database_name": "web-app1111" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "22cc1a6cd1fd4b90b26b063d4b18293f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
